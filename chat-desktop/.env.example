# ═══════════════════════════════════════════════════════════════════════════════
# ChatApp Frontend — Environment Variables (Vite)
# ═══════════════════════════════════════════════════════════════════════════════
# These are baked into the JS bundle at build time.
# Set them in Render → Static Site → Environment BEFORE deploying.
#
# ⚠️  In production, VITE_API_BASE_URL and VITE_SOCKET_URL MUST be full URLs.
#     Relative paths (e.g. /api/chat) will resolve to the static frontend
#     domain, not the backend — causing all API calls to fail.
# ═══════════════════════════════════════════════════════════════════════════════

# Full URL of the ChatApp backend API endpoint
# Development: http://localhost:3200/api/chat  (Vite proxy handles this)
# Production:  https://flowtask-chat-app.onrender.com/api/chat
VITE_API_BASE_URL=http://localhost:3200/api/chat

# Full URL of the ChatApp backend (used by Vite dev proxy)
VITE_BACKEND_URL=http://localhost:3200

# Full URL of the Socket.IO server
# Development: http://localhost:3200
# Production:  https://flowtask-chat-app.onrender.com
VITE_SOCKET_URL=http://localhost:3200

# Enable FlowTask SSO integration tab on login page
VITE_FLOWTASK_ENABLED=true

# FlowTask application URL (used for deep-link redirects from bot messages)
# Development: http://localhost:5173  (or wherever FlowTask frontend runs)
# Production:  https://proofhub-trello-replica.onrender.com
VITE_FLOWTASK_URL=http://localhost:5173
