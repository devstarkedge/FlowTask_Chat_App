# Production Environment Variables
# These variables will be statically baked into the Vite build during npm run build:win

VITE_APP_NAME=TaskChat

# API endpoints must point to the deployed servers, NOT localhost
VITE_API_BASE_URL=https://chat-app-api-cyyl.onrender.com/api/chat
VITE_BACKEND_URL=https://chat-app-api-cyyl.onrender.com
VITE_SOCKET_URL=https://chat-app-api-cyyl.onrender.com

# FlowTask Integration
VITE_FLOWTASK_ENABLED=true
VITE_FLOWTASK_URL=https://flowtask-5viz.onrender.com

# Canvas Collab
VITE_CANVAS_COLLAB_PORT=3201
# Note: Update this once Canvas Collab server is deployed.
VITE_CANVAS_COLLAB_URL=ws://localhost:3201
