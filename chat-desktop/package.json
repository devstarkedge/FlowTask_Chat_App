{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "npm run electron:dev",
    "electron:dev": "node scripts/electron-dev.mjs",
    "build:win": "node scripts/build-windows.mjs",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.1.0",
    "@tanstack/react-query": "^5.100.11",
    "@tiptap/extension-character-count": "^3.23.5",
    "@tiptap/extension-code-block-lowlight": "^3.23.5",
    "@tiptap/extension-collaboration": "^3.23.5",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/extension-color": "^3.23.5",
    "@tiptap/extension-highlight": "^3.23.5",
    "@tiptap/extension-image": "^3.23.5",
    "@tiptap/extension-link": "^3.23.5",
    "@tiptap/extension-mention": "^3.23.5",
    "@tiptap/extension-placeholder": "^3.23.5",
    "@tiptap/extension-table": "^3.23.5",
    "@tiptap/extension-task-item": "^3.23.5",
    "@tiptap/extension-task-list": "^3.23.5",
    "@tiptap/extension-text-align": "^3.23.5",
    "@tiptap/extension-text-style": "^3.23.5",
    "@tiptap/extension-underline": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "@tiptap/suggestion": "^3.23.5",
    "@tiptap/y-tiptap": "^3.0.5",
    "axios": "^1.13.5",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.18.0",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "lodash": "^4.18.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.564.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.2.0",
    "mediasoup-client": "3.24.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.0",
    "react-virtuoso": "^4.18.1",
    "socket.io-client": "^4.8.3",
    "terser": "^5.46.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^43.7.11",
    "electron-builder": "^26.15.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.1.18",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.flowtask.chat",
    "productName": "TaskChat",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TaskChat uses your microphone when you join a Huddle to talk with participants.",
        "NSCameraUsageDescription": "TaskChat uses your camera only when you turn it on in a Huddle."
      },
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "runAfterFinish": true
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
