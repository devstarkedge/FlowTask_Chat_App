# ============================================================================
# FlowTask Chat Mobile — Environment Variables
# ============================================================================

# Backend API Configuration
# Production (default):
API_BASE_URL=https://chat-app-api-cyyl.onrender.com/api/chat
SOCKET_URL=https://chat-app-api-cyyl.onrender.com

# For local development, replace with your machine's IP address:
# API_BASE_URL=http://192.168.1.10:3200/api/chat
# SOCKET_URL=http://192.168.1.10:3200

# FlowTask Integration
FLOWTASK_ENABLED=true
