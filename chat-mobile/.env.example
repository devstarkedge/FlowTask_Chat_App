# ============================================================================
# FlowTask Chat Mobile — Environment Variables
# ============================================================================

# Backend API Configuration
# For local development, use your machine's IP address (not localhost)
# Find your IP: Windows (ipconfig), Mac/Linux (ifconfig)
API_BASE_URL=http://192.168.1.10:3200/api/chat
SOCKET_URL=http://192.168.1.10:3200

# For production
# API_BASE_URL=https://your-backend-url.com/api/chat
# SOCKET_URL=https://your-backend-url.com

# FlowTask Integration
FLOWTASK_ENABLED=true
