{
  "expo": {
    "name": "TaskChat",
    "slug": "chat-mobile-js",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flowtaskchat",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohitgahlyan.chatmobilejs",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "TaskChat accesses your photo library to show recent photos and videos and let you select and upload them to workspace channels and conversations. For example, you can choose a screenshot and share it with members of a channel. TaskChat also uses photo library access when you save downloaded photos and videos to Photos.",
        "NSPhotoLibraryAddUsageDescription": "TaskChat saves photos and videos you download from workspace channels and conversations to your photo library. For example, you can save a photo shared by a channel member to Photos.",
        "NSCameraUsageDescription": "TaskChat uses your camera for Huddle video calls and to take photos and record videos that you choose to share in workspace channels and conversations. For example, you can show a project update during a Huddle or send a photo to members of a channel.",
        "NSMicrophoneUsageDescription": "TaskChat uses your microphone for Huddle calls and to record audio clips and sound for video clips that you choose to share in workspace channels and conversations. For example, you can discuss a project in a Huddle or send a spoken update to members of a channel.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ],
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": []
      },
      "associatedDomains": [
        "applinks:chat.flowtask.com",
        "applinks:chat-app-kte1.onrender.com"
      ],
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.mohitgahlyan.chatmobilejs",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chat.flowtask.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "chat-app-kte1.onrender.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dcfa4a56-c26e-4daf-9e3b-751f3136bd8d"
      }
    },
    "plugins": [
      [
        "./plugins/withAndroidLauncherInset.cjs",
        {
          "insetPercent": 14
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-asset",
      "expo-media-library",
      [
        "expo-camera",
        {
          "recordAudioAndroid": true
        }
      ],
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n-keep class io.webrtc.** { *; }\n-dontwarn io.webrtc.**"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/Vector.png",
          "imageWidth": 200
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/huddle_incoming.wav"
          ]
        }
      ],
      "./plugins/withHuddleCalling.cjs",
      "./plugins/withHuddleBroadcast.cjs"
    ]
  }
}
