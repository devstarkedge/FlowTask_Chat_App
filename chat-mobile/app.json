{
  "expo": {
    "name": "TaskChat",
    "slug": "chat-mobile-js",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flowtaskchat",
    "icon": "./assets/Vector.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Vector.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohitgahlyan.chatmobilejs",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "TaskChat needs access to your photo library to save downloaded images and videos.",
        "NSPhotoLibraryAddUsageDescription": "TaskChat needs permission to save images and videos to your photo library.",
        "NSCameraUsageDescription": "TaskChat needs access to your camera to let you take photos and record videos to share in chats.",
        "NSMicrophoneUsageDescription": "TaskChat needs access to your microphone to let you record audio and video messages."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ],
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": []
      },
      "associatedDomains": [
        "applinks:chat.flowtask.com",
        "applinks:chat-app-kte1.onrender.com"
      ]
    },
    "android": {
      "splash": {
        "image": "./assets/Vector.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/Vector.png"
      },
      "package": "com.mohitgahlyan.chatmobilejs",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chat.flowtask.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "chat-app-kte1.onrender.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dcfa4a56-c26e-4daf-9e3b-751f3136bd8d"
      }
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TaskChat to access your photos.",
          "savePhotosPermission": "Allow TaskChat to save photos and videos to your gallery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TaskChat needs access to your camera to let you take photos and record videos to share in chats.",
          "microphonePermission": "TaskChat needs access to your microphone to let you record audio and video messages.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskChat needs access to your photo library to save downloaded images and videos.",
          "cameraPermission": "TaskChat needs access to your camera to let you take photos and record videos to share in chats."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ]
  }
}
