{
  "expo": {
    "name": "FlowTask-Chat",
    "slug": "chat-mobile-js",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flowtaskchat",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohitgahlyan.chatmobilejs",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "FlowTask-Chat needs access to your photo library to save downloaded images and videos.",
        "NSPhotoLibraryAddUsageDescription": "FlowTask-Chat needs permission to save images and videos to your photo library."
      },
      "associatedDomains": [
        "applinks:chat.flowtask.com",
        "applinks:chat-app-api-cyyl.onrender.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mohitgahlyan.chatmobilejs",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chat.flowtask.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "chat-app-api-cyyl.onrender.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://chat-app-api-cyyl.onrender.com/api/chat",
      "socketUrl": "https://chat-app-api-cyyl.onrender.com",
      "eas": {
        "projectId": "dcfa4a56-c26e-4daf-9e3b-751f3136bd8d"
      }
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow FlowTask-Chat to access your photos.",
          "savePhotosPermission": "Allow FlowTask-Chat to save photos and videos to your gallery."
        }
      ]
    ]
  }
}
