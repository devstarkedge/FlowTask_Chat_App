# ============================================================================
# FlowTask Chat Client — Environment Variables
# ============================================================================
# Copy this file to .env and adjust values.
# Variables must be prefixed with VITE_ to be exposed to the browser.
# ============================================================================

# App name displayed in the UI
VITE_APP_NAME=FlowTask Chat

# API base URL — in production, point to the server domain + path
# In development, leave as '/api/chat' to use Vite proxy.
# The relative path is intentionally used here for Vite proxy behavior.
VITE_API_BASE_URL=/api/chat

# Canonical backend URL used by the Vite proxy config
VITE_BACKEND_URL=http://localhost:3200
VITE_API_URL=http://localhost:3200

# Socket.IO server URL — empty or omit to use window.location.origin.
# Use this when the socket server is handled differently from backend HTTP, 
# otherwise it may be the same as VITE_BACKEND_URL. In production, set to the server's public URL.
VITE_SOCKET_URL=http://localhost:3200

# Enable/disable FlowTask integration UI (SSO tab, project channels, etc.)
VITE_FLOWTASK_ENABLED=true