# ============================================================================
# FlowTask Chat Client — Environment Variables
# ============================================================================
# Copy this file to .env and adjust values.
# Variables must be prefixed with VITE_ to be exposed to the browser.
# ============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=FlowTask Chat

# ─── API Configuration ───────────────────────────────────────────────────────
# Base URL path for API requests (proxied by Vite in development)
VITE_API_BASE_URL=http://localhost:3200/api/chat

# Backend server URL (used by Vite proxy in development)
VITE_BACKEND_URL=http://localhost:3200

# Socket.IO server URL (falls back to window.location.origin if empty)
VITE_SOCKET_URL=http://localhost:3200

# ─── FlowTask Integration ────────────────────────────────────────────────────
# Show FlowTask SSO login tab (set to 'false' for standalone mode)
VITE_FLOWTASK_ENABLED=true

VITE_FLOWTASK_URL=http://localhost:5173
VITE_CANVAS_COLLAB_PORT=3201