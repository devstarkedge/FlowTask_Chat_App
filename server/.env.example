
# ============================================================================
# FlowTask Chat Server — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file — it contains secrets.
# ============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=FlowTask Chat
NODE_ENV=development                         # development | staging | production
PORT=3200                                    # Server listen port
# Development: http://localhost:3200
# Production:  https://flowtask-chat-app.onrender.com
BASE_URL=http://localhost:3200               # Public URL for file links, emails
# Frontend URL used in invite emails and password-reset links.
# Development: http://localhost:5174
# Production:  https://flowtask-client.onrender.com
CLIENT_URL=http://localhost:5174

# ─── Database ─────────────────────────────────────────────────────────────────
# Use a SEPARATE MongoDB database from FlowTask to maintain data isolation.
MONGO_URI=mongodb://localhost:27017/flowtask-chat

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret for signing access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_128_hex_char_secret_here
JWT_EXPIRY=15m                               # Access token TTL

# Secret for signing refresh tokens. Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=your_different_128_hex_char_secret_here
REFRESH_TOKEN_EXPIRY=7d                      # Refresh token TTL

# ─── FlowTask Integration ────────────────────────────────────────────────────
# Set to 'true' to enable FlowTask SSO and webhook integration.
# Set to 'false' for standalone chat operation (no FlowTask dependency).
FLOWTASK_ENABLED=true

# FlowTask backend API URL (for read-only API calls)
# Production: https://proofhub-trello-replica.onrender.com
FLOWTASK_API_URL=https://your-flowtask-api.example.com

# HMAC secret for verifying FlowTask webhook signatures.
# ⚠️  MUST exactly match FlowTask's FLOWTASK_WEBHOOK_SECRET (and CHAT_WEBHOOK_SECRET)
FLOWTASK_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# FlowTask JWT secret for SSO.
# ⚠️  MUST exactly match FlowTask's CHAT_JWT_SECRET
FLOWTASK_JWT_SECRET=your_flowtask_jwt_secret_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# REQUIRED in production — server exits if not set when NODE_ENV=production.
# Must include BOTH the ChatApp frontend AND the FlowTask frontend.
# Production: https://flowtask-client.onrender.com,https://flowtask-x3z4.onrender.com
CORS_ORIGINS=http://localhost:5174

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Set to number of trusted proxies (1 for single reverse proxy like nginx).
# Required for correct IP detection behind load balancers.
TRUST_PROXY=1

# ─── Email ────────────────────────────────────────────────────────────────────
# SMTP configuration for email verification and password reset.
# Leave SMTP_HOST blank to use console logging in development.
SMTP_HOST=                                   # e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                                   # SMTP username
SMTP_PASS=                                   # SMTP password or app-specific password
SMTP_FROM=                                   # Sender email address

# ─── Redis (recommended for production) ───────────────────────────────────────
# Enables Redis-backed rate limiting, caching, and BullMQ job queues.
# Without Redis, the app uses in-memory fallbacks (not suitable for multi-instance).
REDIS_URL=redis://localhost:6379

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads                         # Local upload directory
MAX_FILE_SIZE=10485760                       # Max file size in bytes (default: 10MB)

# ─── Cloudinary (optional CDN for file storage) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info       

KLIPY_API_KEY=BzOjYLM3AOvMyEuEKEzdRifPfwqgPWycjkBi4rDxARdPnMJCQiLS3ilrneaLa7F7

# ─── Multi-Tenant Workspace ──────────────────────────────────────────────────
DEFAULT_WORKSPACE_SLUG=flowtask              # Default workspace slug
DEFAULT_WORKSPACE_NAME=FlowTask              # Default workspace display name
WORKSPACE_SUBDOMAIN_ENABLED=false            # Enable subdomain-based workspace routing
