# ============================================================================
# FlowTask Chat Server — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file — it contains secrets.
# ============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=FlowTask Chat
NODE_ENV=development
PORT=3200
BASE_URL=http://localhost:3200

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string. Required.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# ─── Authentication (Native Chat Users) ──────────────────────────────────────
# Secret for signing access tokens issued by the Chat server.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-64-char-hex-secret-here
JWT_EXPIRY=15m

# Secret for signing refresh tokens. Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=generate-a-different-64-char-hex-secret-here
REFRESH_TOKEN_EXPIRY=7d

# ─── FlowTask Integration ────────────────────────────────────────────────────
# Set to 'true' to enable FlowTask SSO and webhook integration.
# Set to 'false' for standalone chat operation (no FlowTask dependency).
FLOWTASK_ENABLED=true

# FlowTask backend API URL (required when FLOWTASK_ENABLED=true)
FLOWTASK_API_URL=https://your-flowtask-api.example.com

# Shared secret for verifying FlowTask webhook signatures (HMAC-SHA256).
FLOWTASK_WEBHOOK_SECRET=generate-a-webhook-secret-here

# JWT secret used by FlowTask to sign its tokens (must match FlowTask's JWT_SECRET).
# Only required when FLOWTASK_ENABLED=true.
FLOWTASK_JWT_SECRET=must-match-flowtask-jwt-secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5174

# ─── Email (Verification & Password Reset) ───────────────────────────────────
# Leave SMTP_HOST blank to use console logging (development mode).
# Configure for production email delivery via SMTP / transactional service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@flowchat.local

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Redis (Optional — for rate limiting & sessions in multi-instance) ────────
# REDIS_URL=redis://localhost:6379

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Set to number of trusted proxies (1 for single reverse proxy like nginx).
# Required for correct IP detection behind load balancers / reverse proxies.
TRUST_PROXY=0
